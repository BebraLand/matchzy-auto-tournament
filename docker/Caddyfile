# ========================================

# Caddy Configuration for MatchZy Auto Tournament

# ========================================

# Internal reverse proxy that runs inside Docker container

# Serves everything through a single port (3069)

#

# Routes:

# / → React frontend (SPA)

# /api/\* → Express backend API

# /socket.io/\* → Socket.IO WebSocket

# /health → Health check endpoint

# ========================================

:3069 {
	# Keep routing order explicit: a map image must reach Express before the
	# SPA fallback has a chance to rewrite it to index.html.
	route {
		reverse_proxy /api/* localhost:3000
		reverse_proxy /socket.io/* localhost:3000
		reverse_proxy /health localhost:3000
		reverse_proxy /map-images/* localhost:3000

		# Serve React frontend from /app/public.
		root * /app/public

		# Handle SPA routing: try file, then fallback to index.html.
		@notAPI {
			not path /api/*
			not path /socket.io/*
			not path /health
			not path /map-images/*
			file {
				try_files {path} /index.html
			}
		}
		rewrite @notAPI {http.matchers.file.relative}
		file_server
	}
}
