# ========================================

# Caddy Configuration for MatchZy Auto Tournament

# ========================================

# Internal reverse proxy that runs inside Docker container

# Serves everything through a single port (3069)

#

# Routes:

# / → React frontend (SPA)

# /api/\* → Express backend API

# /socket.io/\* → Socket.IO WebSocket

# /health → Health check endpoint

# ========================================

:3069 {
	# These mutually exclusive handlers prevent API and uploaded-image requests
	# from falling through to the React SPA.
	handle /api/* {
		reverse_proxy localhost:3000
	}
	handle /socket.io/* {
		reverse_proxy localhost:3000
	}
	handle /health {
		reverse_proxy localhost:3000
	}
	handle /map-images/* {
		reverse_proxy localhost:3000
	}

	handle {
		root * /app/public
		try_files {path} /index.html
		file_server
	}
}
